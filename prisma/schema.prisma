generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AvailabilityStatus {
  AVAILABLE
  SEASONAL
  LIMITED
}

enum DocumentType {
  COMPANY_LEGALITY
  FOOD_SAFETY
  EXPORT_CERTIFICATE
}

enum Incoterm {
  FOB_JAKARTA
  FOB_BELITUNG
  CIF
  CNF
}

enum ShippingMode {
  SEA_REEFER
  AIR_CARGO
}

enum InquiryStatus {
  NEW
  QUOTED
  NEGOTIATING
  CLOSED_WON
  CLOSED_LOST
}

model Category {
  id         Int       @id @default(autoincrement())
  nameEn     String    @map("name_en") @db.VarChar(100)
  slug       String    @unique @db.VarChar(100)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  products   Product[]

  @@map("categories")
}

model Product {
  id                 Int                @id @default(autoincrement())
  categoryId         Int                @map("category_id")
  category           Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  nameEn             String             @map("name_en") @db.VarChar(150)
  localNameId        String?            @map("local_name_id") @db.VarChar(150)
  latinName          String             @map("latin_name") @db.VarChar(150)
  slug               String             @unique @db.VarChar(150)
  hsCode             String?            @map("hs_code") @db.VarChar(20)
  originArea         String             @default("Belitung Island, Indonesia") @map("origin_area") @db.VarChar(100)
  processingTypes    String             @map("processing_types") @db.VarChar(255)
  freezingMethods    String             @map("freezing_methods") @db.VarChar(150)
  sizeGrades         String             @map("size_grades") @db.VarChar(255)
  packagingSpec      String             @map("packaging_spec") @db.VarChar(255)
  moqSpec            String             @map("moq_spec") @db.VarChar(100)
  availabilityStatus AvailabilityStatus @default(AVAILABLE) @map("availability_status")
  peakMonths         String?            @map("peak_months") @db.VarChar(100)
  descriptionEn      String             @map("description_en") @db.Text
  imageUrl           String             @map("image_url") @db.VarChar(255)
  isFeatured         Boolean            @default(false) @map("is_featured")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  inquiryItems       InquiryItem[]

  @@map("products")
}

model ComplianceDocument {
  id                 Int          @id @default(autoincrement())
  titleEn            String       @map("title_en") @db.VarChar(150)
  issuer             String       @db.VarChar(150)
  documentType       DocumentType @map("document_type")
  registrationNumber String?      @map("registration_number") @db.VarChar(100)
  descriptionEn      String       @map("description_en") @db.Text
  badgeIconUrl       String?      @map("badge_icon_url") @db.VarChar(255)
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("compliance_documents")
}

model Inquiry {
  id               Int             @id @default(autoincrement())
  inquiryCode      String          @unique @map("inquiry_code") @db.VarChar(30)
  buyerName        String          @map("buyer_name") @db.VarChar(150)
  companyName      String          @map("company_name") @db.VarChar(150)
  country          String          @db.VarChar(100)
  email            String          @db.VarChar(150)
  phoneWhatsapp    String?         @map("phone_whatsapp") @db.VarChar(50)
  preferredIncoterm Incoterm       @default(FOB_JAKARTA) @map("preferred_incoterm")
  shippingMode     ShippingMode    @default(SEA_REEFER) @map("shipping_mode")
  destinationPort  String?         @map("destination_port") @db.VarChar(150)
  additionalNotes  String?         @map("additional_notes") @db.Text
  status           InquiryStatus   @default(NEW)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamp(0)
  items            InquiryItem[]

  @@map("inquiries")
}

model InquiryItem {
  id                Int     @id @default(autoincrement())
  inquiryId         Int     @map("inquiry_id")
  inquiry           Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  productId         Int     @map("product_id")
  product           Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  requestedForm     String? @map("requested_form") @db.VarChar(100)
  requestedSize     String? @map("requested_size") @db.VarChar(100)
  estimatedQuantity String  @map("estimated_quantity") @db.VarChar(100)

  @@map("inquiry_items")
}
